#version 150

in vec2 Position;
out vec2 vClip;

void main() {
    vClip = Position;
    // z = 0.999999 - чуть ближе дальней плоскости (не ровно 1.0, чтобы не зависеть
    // от точного равенства float). Вместе с depth func GL_GREATER в рендерере:
    // тест "0.999999 > buffer" истинен там, где buffer < 0.999999, то есть где
    // уже отрисована геометрия руки/предмета; ложен на пустом фоне (buffer == 1.0
    // после очистки) - там фрагмент отбрасывается.
    gl_Position = vec4(Position, 0.999999, 1.0);
}
